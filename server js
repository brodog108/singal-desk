require('dotenv').config();
const express = require('express');
const crypto = require('crypto');
const Stripe = require('stripe');
const Anthropic = require('@anthropic-ai/sdk');
const Database = require('better-sqlite3');
const path = require('path');

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY);
const ai = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });
const BASE = (process.env.BASE_URL || 'http://localhost:3000').replace(/\/$/, '');
const MODEL = process.env.CLAUDE_MODEL || 'claude-sonnet-5-5';

// Plans: daily scan caps reset every UTC day and never roll over.
const PLANS = {
  basic:     { name: 'Basic',     usd: 10,  cap: 10,   price: process.env.PRICE_BASIC },
  gold:      { name: 'Gold',      usd: 20,  cap: 25,   price: process.env.PRICE_GOLD },
  platinum:  { name: 'Platinum',  usd: 50,  cap: 50,   price: process.env.PRICE_PLATINUM },
  unlimited: { name: 'Unlimited', usd: 250, cap: 1e9,  price: process.env.PRICE_UNLIMITED },
};

const db = new Database(process.env.DB_PATH || 'data.db');
db.exec(`
  create table if not exists users(
    access_key text primary key, customer text unique, subscription text,
    plan text, status text, period_end integer);
  create table if not exists usage(
    access_key text, day text, n integer, primary key(access_key, day));
`);

const today = () => new Date().toISOString().slice(0, 10);
const planOfPrice = id => Object.keys(PLANS).find(k => PLANS[k].price === id);

function syncSub(sub) {
  const item = sub.items.data[0];
  const end = (sub.current_period_end || item.current_period_end) * 1000;
  db.prepare('update users set subscription=?, plan=?, status=?, period_end=? where customer=?')
    .run(sub.id, planOfPrice(item.price.id) || null, sub.status, end, sub.customer);
}

function authUser(req) {
  const key = req.get('x-access-key');
  if (!key) return null;
  const u = db.prepare('select * from users where access_key=?').get(key);
  if (!u || !PLANS[u.plan]) return null;
  if (!['active', 'trialing'].includes(u.status) || u.period_end < Date.now()) return null;
  return u;
}

const usedToday = key =>
  (db.prepare('select n from usage where access_key=? and day=?').get(key, today()) || { n: 0 }).n;

const app = express();

// Stripe webhook: needs the raw body, so it is registered before express.json().
app.post('/webhook', express.raw({ type: 'application/json' }), (req, res) => {
  let event;
  try {
    event = stripe.webhooks.constructEvent(req.body, req.get('stripe-signature'), process.env.STRIPE_WEBHOOK_SECRET);
  } catch (e) {
    return res.status(400).send('Bad signature');
  }
  if (event.type.startsWith('customer.subscription.')) syncSub(event.data.object);
  res.json({ received: true });
});

app.use(express.json({ limit: '8mb' }));
app.get('/', (_req, res) => res.sendFile(path.join(__dirname, 'index.html')));
app.get('/terms.html', (_req, res) => res.sendFile(path.join(__dirname, 'terms.html')));

app.get('/api/plans', (_req, res) =>
  res.json(Object.entries(PLANS).map(([id, p]) => ({ id, name: p.name, usd: p.usd, cap: p.cap >= 1e9 ? null : p.cap }))));

app.post('/api/checkout', async (req, res) => {
  const plan = PLANS[req.body.plan];
  if (!plan || !plan.price) return res.status(400).json({ error: 'bad_plan' });
  const s = await stripe.checkout.sessions.create({
    mode: 'subscription',
    line_items: [{ price: plan.price, quantity: 1 }],
    success_url: `${BASE}/?session_id={CHECKOUT_SESSION_ID}`,
    cancel_url: BASE,
    allow_promotion_codes: true,
  });
  res.json({ url: s.url });
});

// After paying, Stripe sends the customer back with a session id. We verify it with
// Stripe, then hand out (or re-show) the customer's access key.
app.get('/api/claim', async (req, res) => {
  try {
    const s = await stripe.checkout.sessions.retrieve(String(req.query.session_id), { expand: ['subscription'] });
    if (s.status !== 'complete' || !['paid', 'no_payment_required'].includes(s.payment_status))
      return res.status(402).json({ error: 'not_paid' });
    let u = db.prepare('select * from users where customer=?').get(s.customer);
    if (!u) {
      const key = 'sd_' + crypto.randomBytes(18).toString('hex');
      db.prepare('insert into users(access_key, customer) values(?,?)').run(key, s.customer);
      u = { access_key: key };
    }
    syncSub(s.subscription);
    res.json({ key: u.access_key });
  } catch (e) {
    res.status(400).json({ error: 'claim_failed' });
  }
});

app.get('/api/me', (req, res) => {
  const u = authUser(req);
  if (!u) return res.status(402).json({ error: 'subscription_required' });
  const cap = PLANS[u.plan].cap;
  res.json({ plan: PLANS[u.plan].name, cap: cap >= 1e9 ? null : cap, left: cap >= 1e9 ? null : Math.max(0, cap - usedToday(u.access_key)), renews: u.period_end });
});

app.post('/api/portal', async (req, res) => {
  const u = authUser(req);
  if (!u) return res.status(402).json({ error: 'subscription_required' });
  const s = await stripe.billingPortal.sessions.create({ customer: u.customer, return_url: BASE });
  res.json({ url: s.url });
});

const PROMPT = `You are a careful technical-analysis assistant. The attached image should be a stock price chart screenshot. Read ONLY what is visible: ticker, timeframe, last price, trend, moving averages, indicators such as RSI, MACD and volume, support and resistance, and recent candles. Reply with ONLY JSON in this shape: {"ticker":string|null,"timeframe":string|null,"signal":"BUY"|"SELL"|"HOLD","headline":"clear action title of at most 8 words","summary":"1 to 2 plain sentences on why","confidence":number 0-100,"stats":{"price":string|null,"trend":"Uptrend"|"Downtrend"|"Sideways"|null,"momentum":string|null,"rsi":string|null,"support":string|null,"resistance":string|null,"target":string|null,"stop_loss":string|null},"reasons":[3 to 5 short strings],"caveat":string}. Use null for anything you cannot read. If the image is not a price chart, use signal HOLD, confidence 0, and say so in summary.`;

app.post('/api/scan', async (req, res) => {
  const u = authUser(req);
  if (!u) return res.status(402).json({ error: 'subscription_required' });
  const m = /^data:(image\/(?:jpeg|png|webp|gif));base64,([A-Za-z0-9+/=]+)$/.exec(req.body.image || '');
  if (!m) return res.status(400).json({ error: 'bad_image' });

  const cap = PLANS[u.plan].cap, day = today();
  // Atomically take one scan; if the cap is already reached nothing is returned.
  const taken = db.prepare(
    `insert into usage(access_key, day, n) values(?,?,1)
     on conflict(access_key, day) do update set n = n + 1 where n < ? returning n`
  ).get(u.access_key, day, cap);
  if (!taken) return res.status(429).json({ error: 'daily_limit' });

  try {
    const msg = await ai.messages.create({
      model: MODEL,
      max_tokens: 1200,
      messages: [{ role: 'user', content: [
        { type: 'image', source: { type: 'base64', media_type: m[1], data: m[2] } },
        { type: 'text', text: PROMPT },
      ] }],
    });
    const text = msg.content.filter(b => b.type === 'text').map(b => b.text).join('');
    const result = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));
    res.json({ result, left: cap >= 1e9 ? null : cap - taken.n });
  } catch (e) {
    db.prepare('update usage set n = n - 1 where access_key=? and day=? and n > 0').run(u.access_key, day);
    res.status(502).json({ error: 'scan_failed' });
  }
});

app.listen(process.env.PORT || 3000, () => console.log('Signal Desk running on ' + BASE));
