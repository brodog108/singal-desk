<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Signal Desk</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--tx:#14181f;--mut:#6a7280;--bd:#d5d9e1;--buy:#0f9d58;--sell:#d93025;--hold:#b7791f;--acc:#2f5bea}
@media(prefers-color-scheme:dark){:root{--bg:#0e1116;--card:#171b22;--tx:#e8ebf0;--mut:#8b94a3;--bd:#2f3642;--buy:#1fae68;--sell:#e5483d;--hold:#c98a1f;--acc:#7a9bff;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
main{max-width:600px;margin:0 auto;padding:24px 16px 40px}
h1{font-size:26px;margin:0}p.sub{color:var(--mut);margin:2px 0 18px}
.drop{display:block;text-align:center;border:2px dashed var(--bd);border-radius:16px;padding:34px 16px;cursor:pointer;background:var(--card)}
.drop b{display:block;font-size:18px;margin-bottom:4px}.drop span{color:var(--mut);font-size:14px}
#prev{display:block;max-width:100%;max-height:200px;margin:14px auto 0;border-radius:10px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;overflow:hidden;margin-top:16px}
.top{padding:20px 18px;color:#fff;text-align:center}
.top.BUY{background:var(--buy)}.top.SELL{background:var(--sell)}.top.HOLD{background:var(--hold)}
.top small{opacity:.9;font-size:13px;letter-spacing:.08em;text-transform:uppercase}
.top h2{margin:2px 0;font-size:46px;line-height:1.1}.top p{margin:4px 0 0;font-size:18px;font-weight:600}
.body{padding:16px 18px}.sum{margin:0 0 14px}
.conf{display:flex;align-items:center;gap:10px;color:var(--mut);font-size:13px;margin-bottom:14px}
.bar{flex:1;height:8px;background:var(--bd);border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--acc)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
.k{background:var(--bg);border-radius:10px;padding:10px}.k b{display:block;font-size:17px}.k span{font-size:12px;color:var(--mut)}
h3{font-size:15px;margin:18px 0 4px}ul{margin:0;padding-left:20px}li{margin:4px 0}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
a.btn,button{background:var(--acc);color:#fff;border:0;border-radius:10px;padding:10px 14px;font:inherit;font-weight:600;text-decoration:none;cursor:pointer}
button.alt{background:transparent;color:var(--tx);border:1px solid var(--bd)}
.msg{margin-top:16px;color:var(--mut);text-align:center}
.plans{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:10px}
.plan{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;text-align:center}
.plan h3{margin:0}.plan .pr{font-size:26px;font-weight:800;margin:4px 0}.plan .pr small{font-size:13px;font-weight:400;color:var(--mut)}
.plan p{margin:0 0 10px;color:var(--mut);font-size:13px}.plan button{width:100%}
.status,.key{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px 14px;margin-bottom:14px;font-size:14px}
.key code{display:block;word-break:break-all;margin:6px 0;font-size:13px}
input.in{width:100%;background:var(--bg);color:var(--tx);border:1px solid var(--bd);border-radius:8px;padding:9px;font:inherit}
small.fine{display:block;color:var(--mut);margin-top:18px;font-size:12px}
[hidden]{display:none!important}
</style></head><body><main>
<h1>Signal Desk</h1>
<p class="sub">Upload a stock chart screenshot. Get a clear buy, sell or hold call.</p>

<div id="keybox" class="key" hidden><b>Save your access key</b><code id="keyval">
